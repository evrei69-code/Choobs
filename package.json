{
  "name": "choobs",
  "version": "0.1.0",
  "description": "Choobs VPN client for Windows 7",
  "main": "main.js",
  "scripts": {
    "prestart": "node scripts/build-core-manager.js",
    "start": "electron .",
    "preview": "node scripts/preview-server.js",
    "build:win": "node scripts/build-installer.js",
    "build:portable": "node scripts/build-portable.js",
    "build:win:portable": "node scripts/build-portable.js",
    "test:ipc": "node --test tests/core-ipc.test.js",
    "test:subscriptions": "node --test tests/subscriptions.test.js",
    "test:ui": "node --test tests/ui-state.test.js tests/config-store.test.js"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "26.15.3"
  },
  "allowScripts": {
    "electron@22.3.27": true
  },
  "build": {
    "appId": "com.choobs.desktop",
    "productName": "Choobs",
    "executableName": "Choobs",
    "asar": true,
    "asarUnpack": [
      "assets/icons/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "config-store.js",
      "app/**/*",
      "assets/icons/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/choobs-core-manager.exe",
        "to": "backend/choobs-core-manager.exe"
      },
      {
        "from": "backend/core-hashes.json",
        "to": "backend/core-hashes.json"
      },
      {
        "from": "core/bin/sing-box.exe",
        "to": "core/bin/sing-box.exe"
      },
      {
        "from": "core/bin/xray.exe",
        "to": "core/bin/xray.exe"
      },
      {
        "from": "core/configs",
        "to": "core/configs",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/choobs.ico",
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Choobs",
      "installerIcon": "build/choobs.ico",
      "uninstallerIcon": "build/choobs.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Choobs-${version}-Setup.${ext}"
    }
  }
}
